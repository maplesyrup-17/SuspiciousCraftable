  "description": "A mod that makes suspicious sand and gravel craftable with any item inside",
  "authors": [],
  "contact": {},
  "license": "GPL-3.0",
  "icon": "assets/suspiciouscraftable/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.maplesyrup.suspiciouscraftable.Suspiciouscraftable"
    ]
  },
  "mixins": [
    "suspiciouscraftable.mixins.json"
  ],
  "depends": {
